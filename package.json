{
  "name": "spawner-site",
  "version": "0.0.0",
  "private": true,
  "description": "The website and documentation of Spawner: preview environments for every branch, on your own server",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flosk6/spawner-site.git"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:local": "SPAWNER_DOCS_DIR=../spawner astro dev",
    "docs:fetch": "node scripts/fetch-docs.mjs",
    "build": "node scripts/fetch-docs.mjs && astro build",
    "preview": "astro preview",
    "preview:cloudflare": "pnpm dlx wrangler@4.139.0 dev",
    "check": "astro check",
    "test": "vitest run",
    "links": "node scripts/check-links.mjs",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "images": "node scripts/render-images.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.5",
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource-variable/overpass-mono": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "astro": "7.3.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
