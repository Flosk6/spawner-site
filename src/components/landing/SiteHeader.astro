---
/**
 * The header of the home page and of the pages built like it: the wordmark,
 * the main navigation, GitHub, the theme and the install button. Its links
 * are absolute, so that it works on every page, the 404 page included.
 */
import { NAV, REPO_URL } from '../../lib/site';
import Wordmark from '../Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname;
---

<header class="header">
  <div class="wrap bar">
    <a class="home" href="/"><Wordmark /></a>
    <nav class="nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="end">
      <a class="github" href={REPO_URL}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
          ></path>
        </svg>
        <span class="github-label">GitHub</span>
      </a>
      <ThemeToggle />
      <a class="button button-small" href="/#install">Install</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--sp-border);
    background: var(--sp-bg);
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 1rem;
  }

  .home {
    display: flex;
    align-items: center;
    color: var(--sp-text);
    font-size: 1.625rem;
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a,
  .github {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    color: var(--sp-text-2);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav a:hover,
  .github:hover {
    color: var(--sp-text);
  }

  .nav a[aria-current='page'] {
    color: var(--sp-text);
    text-decoration: underline;
    text-decoration-color: var(--sp-mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .github svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  .end {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  @media (max-width: 64rem) {
    .nav ul {
      gap: 0 1.1rem;
    }
  }

  @media (max-width: 56rem) {
    .bar {
      grid-template-columns: 1fr auto;
      row-gap: 0.25rem;
      padding-block: 0.5rem;
    }

    .nav a {
      min-height: 2.25rem;
    }

    .nav {
      grid-row: 2;
      grid-column: 1 / -1;
    }

    .nav ul {
      justify-content: flex-start;
    }
  }

  @media (max-width: 30rem) {
    .bar {
      column-gap: 1rem;
    }

    .home {
      font-size: 1.5rem;
    }

    .end {
      gap: 0.7rem;
    }

    .nav ul {
      justify-content: space-between;
      gap: 0 0.75rem;
    }

    .nav a {
      font-size: 0.875rem;
    }

    .github {
      padding-inline: 0.35rem;
    }

    .github-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  @media (max-width: 24rem) {
    .github {
      display: none;
    }
  }

  @media (max-width: 22.5rem) {
    .home {
      font-size: 1.375rem;
    }

    .end {
      gap: 0.6rem;
    }

    .nav ul {
      gap: 0 0.5rem;
    }

    .nav a {
      font-size: 0.8125rem;
    }
  }
</style>
