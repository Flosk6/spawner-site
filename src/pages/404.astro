---
/**
 * The page served for any address the site does not have: the pages most
 * readers were looking for, and the way to the docs' search.
 */
import SiteFooter from '../components/landing/SiteFooter.astro';
import SiteHeader from '../components/landing/SiteHeader.astro';
import Landing from '../layouts/Landing.astro';
import { describedVersion, docsSource } from '../lib/docs-source';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Documentation', href: '/docs/' },
  { label: 'Quickstart', href: '/docs/quickstart/' },
  { label: 'Installing Spawner', href: '/docs/install/' },
  { label: 'The CLI and the MCP server', href: '/docs/cli/' },
  { label: 'The .spawner/ directory', href: '/docs/manifest/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Changelog', href: '/changelog/' },
];
---

<Landing title="Page not found | Spawner" description="This page does not exist, or it moved." noindex>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <section class="section" aria-labelledby="not-found-title">
      <div class="wrap content">
        <h1 class="section-title" id="not-found-title">This page does not exist</h1>
        <p>
          It may have moved when the documentation changed. One of these pages should get you there; on any page of
          <a href="/docs/">the documentation</a>, <kbd>Ctrl</kbd>+<kbd>K</kbd> (<kbd>Cmd</kbd>+<kbd>K</kbd> on a Mac) opens its search.
        </p>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <SiteFooter described={describedVersion(docsSource())} />
</Landing>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 50vh;
  }

  p {
    max-width: 40rem;
    color: var(--sp-text-2);
  }

  kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--sp-border-strong);
    border-radius: 4px;
    background: var(--sp-surface);
    color: var(--sp-text);
    font-family: var(--sp-font-mono);
    font-size: 0.8125em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }
</style>
