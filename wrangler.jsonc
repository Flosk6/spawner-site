// The site on Cloudflare: Workers static assets, with no Worker script. The
// files of dist/ are served as they are, with public/_headers and
// public/_redirects (copied into dist/ by the build). Deployed by
// .github/workflows/deploy.yml; `pnpm preview:cloudflare` serves dist/ the
// same way on http://localhost:8787.
{
  "name": "spawner-site",
  // The runtime of the Wrangler version the deploy pins (workerd 1.20260923).
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    // Any path without a file gets dist/404.html, with a 404 status.
    "not_found_handling": "404-page",
    // Every page is a directory with an index.html (Astro's trailingSlash:
    // 'always'): /docs/install and /docs/install/index.html redirect to
    // /docs/install/, the URL of the canonical link and the sitemap.
    "html_handling": "force-trailing-slash"
  },
  // spawner.run itself: Cloudflare creates its DNS record and certificate.
  // www.spawner.run is a redirect rule of the zone, not a second copy here.
  "routes": [{ "pattern": "spawner.run", "custom_domain": true }],
  // No other address serves the site: no workers.dev subdomain, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Wrangler sends no usage data from this project.
  "send_metrics": false
}
